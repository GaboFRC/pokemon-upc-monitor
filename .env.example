# ------------------------------------------------------------------ notificaciones
# ntfy.sh: elige un topic largo y dificil de adivinar (es publico para quien lo sepa).
# Instala la app ntfy en el celular y suscribete al mismo topic.
NTFY_TOPIC=pokemon-upc-weplay-cambia-esto-7f3a
NTFY_SERVER=https://ntfy.sh

# Telegram (opcional). Crea el bot con @BotFather y obten tu chat id con @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------ frecuencia y red
INTERVAL_MINUTES=10
REQUEST_TIMEOUT=30
MAX_RETRIES=3
PAUSE_MIN_SECONDS=3
PAUSE_MAX_SECONDS=7

# ------------------------------------------------------------------ productos vigilados por URL
# Avisan cuando quedan comprables online (boton de carrito y no "Disponible solo en tienda").
# Varias URLs separadas por coma.
WATCH_URLS=https://www.weplay.cl/pokemon-tcg-30th-celebration-elite-trainer-box-english.html

# ------------------------------------------------------------------ fuentes
# Terminos de la busqueda interna, separados por coma.
# "30th" es el mas preciso; "ultra premium" es red de seguridad por si cambian el nombre.
SEARCH_TERMS=30th,ultra premium

# Listado de la marca Pokemon (brand_id=2049) como respaldo.
CHECK_BRAND_LISTING=true

# Pagina de preventas.
CHECK_PREVENTAS=true

# Sondear las 6 URLs de producto mas probables (suma 6 peticiones por ciclo).
# Util solo si temes que el producto se publique sin quedar indexado en la busqueda.
PROBE_PRODUCT_URLS=false

# Abrir la ficha con Playwright cuando el HTML plano no revele el stock.
# Requiere: pip install playwright && playwright install chromium
PLAYWRIGHT_FALLBACK=false

# ------------------------------------------------------------------ archivos
STATE_FILE=state.json
LOG_FILE=monitor.log
